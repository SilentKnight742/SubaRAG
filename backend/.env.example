SARVAM_API_KEY=
ELEVENLABS_API_KEY=
HF_TOKEN=
# Enable the verified remote pilot by uncommenting both lines below.
# SUBARAG_DATA_REPO=silentkirmada/SubaRAG-data
# SUBARAG_DATA_REVISION=e29f5c990a4fc0d8e05771be4007f1c6560adfc2
GEMINI_API_KEY=
SUBARAG_GEMINI_MODEL=gemini-3.5-flash-lite
SUBARAG_TRANSCRIPTION_PROVIDER=elevenlabs
SUBARAG_ALLOW_PROVIDER_SELECTION=false
# Required for an internet-facing preview; Render generates this automatically.
# Username: subarag. Leave unset for localhost-only development.
# SUBARAG_PREVIEW_PASSWORD=
# Optional prepared-corpus manifest (metadata only; no RAG index in step one).
# SUBARAG_DATA_MANIFEST=/data/corpus/manifest.json
# Configure all three together to enable grounded answers.
# SUBARAG_RETRIEVAL_MANIFEST_EN=/data/index-en/retrieval-manifest.json
# SUBARAG_RETRIEVAL_MANIFEST_HI=/data/index-hi/retrieval-manifest.json
# SUBARAG_RETRIEVAL_MANIFEST_MR=/data/index-mr/retrieval-manifest.json
# Remote alternative: leave disabled until the RAG serving image is memory-verified.
# Set all three together, with HF_TOKEN and GEMINI_API_KEY; do not set local indexes too.
# SUBARAG_RETRIEVAL_REPO=silentkirmada/SubaRAG-data
# SUBARAG_RETRIEVAL_REVISION=9f6d55f53b9479930613e4c849e5e834a4230d0a
# SUBARAG_RETRIEVAL_PATH=retrieval/e7a5c4e6bd668ccfeadbe8f2178d20f9a8570e51937d3592813af55ded2fac68
# Compact alternative: local, verified serving bundle and GEMINI_API_KEY.
# Do not combine with the full-size retrieval options above. Keep disabled until validated.
# SUBARAG_COMPACT_MANIFEST=/data/compact/compact-bundle.json
# Remote compact alternative: set all three with HF_TOKEN and GEMINI_API_KEY.
# SUBARAG_COMPACT_REPO=silentkirmada/SubaRAG-data
# SUBARAG_COMPACT_REVISION=3f0ef0a35e7fd2cf733c6ff6e1ac9a9e49a539d6
# SUBARAG_COMPACT_PATH=serving/compact/27cb87a265d9058a4c512d138519bfd9060c156bf1abef1a24a07919bcc36115
# Set by the Docker image; omit for the separate Vite development server.
# SUBARAG_FRONTEND_DIST=/app/frontend/dist
